<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recipesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#234B35" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recipes you can make with your current ingredients and quantities."
            android:textSize="16sp"
            android:textColor="#454545" />

        <TextView
            android:id="@+id/recipeCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#234B35" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/recipeList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false"
            android:divider="#D5DECF"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/emptyRecipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="No recipes match your pantry yet.\nAdd the required ingredients and quantities, then check again."
            android:textSize="18sp"
            android:textColor="#454545" />

    </FrameLayout>

    <Button
        android:id="@+id/backToPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minHeight="48dp"
        android:text="Back to Pantry"
        android:textColor="#FFFFFF"
        android:backgroundTint="#286440" />

</LinearLayout>