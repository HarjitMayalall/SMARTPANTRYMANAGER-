<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Pantry"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#234B35" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage your ingredients and discover what you can cook."
            android:textSize="16sp"
            android:textColor="#454545" />

        <Button
            android:id="@+id/addIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            android:text="Add Ingredient"
            android:textColor="#FFFFFF"
            android:backgroundTint="#286440" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/pantryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false"
            android:divider="#D5DECF"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/emptyPantry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Your pantry is empty.\nTap Add Ingredient to get started."
            android:textSize="18sp"
            android:textColor="#454545" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#E5EDDF">

        <Button
            android:id="@+id/showRecipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Recipes"
            android:textColor="#FFFFFF"
            android:backgroundTint="#286440" />

        <Button
            android:id="@+id/showSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:minHeight="48dp"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:backgroundTint="#286440" />

    </LinearLayout>

</LinearLayout>